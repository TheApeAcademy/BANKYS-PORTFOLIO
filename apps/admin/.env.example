NEXT_PUBLIC_SUPABASE_URL=https://rxyqoaucuwdgpbzgfjqp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<Project Settings → API → anon/publishable key>

# Public origin of the Zebraish Studio site — used to build the client
# tracking/pay links shown on a project's detail page. Optional; defaults to
# the current *.vercel.app deployment if unset. Set this once a custom
# domain is attached to the studio app.
NEXT_PUBLIC_STUDIO_URL=https://bankys-portfolio.vercel.app

# Optional — enables the automatic "you're approved" email (with access code)
# sent when a collaborator application is approved. Requires a verified
# domain (Resend can't verify a *.vercel.app address).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
