NEXT_PUBLIC_SUPABASE_URL=https://rxyqoaucuwdgpbzgfjqp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only for the Flutterwave payment callback/webhook (server-to-server,
# no admin session involved). Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave Dashboard -> Settings -> API keys (use the Secret Key, not the Public Key).
FLUTTERWAVE_SECRET_KEY=
# Flutterwave Dashboard -> Settings -> Webhooks -> Secret Hash (you set this yourself).
FLUTTERWAVE_SECRET_HASH=

# Optional — enables automatic client/admin confirmation emails via Resend.
# Requires a verified domain (Resend can't verify a *.vercel.app address).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
